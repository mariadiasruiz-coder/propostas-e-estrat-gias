 "legendas": [
  {
   "in": 0.66,
   "out": 1.98,
   "texto": "E se a vida que você quiser construir"
  },
  {
   "in": 2.02,
   "out": 3.86,
   "texto": "estiver do outro lado de uma decisão"
  },
  {
   "in": 3.9,
   "out": 4.96,
   "texto": "que você ainda não tomou?"
  },
  {
   "in": 5.27,
   "out": 7.45,
   "texto": "Muita gente ainda acredita que precisa"
  },
  {
   "in": 7.49,
   "out": 9.89,
   "texto": "de milhares de seguidores pra viver de conteúdo."
  },
  {
   "in": 9.93,
   "out": 11.73,
   "texto": "Mas a verdade é que existe um outro caminho."
  },
  {
   "in": 11.77,
   "out": 13.79,
   "texto": "Um caminho mais estratégico, mais real"
  },
  {
   "in": 13.83,
   "out": 15.94,
   "texto": "e muito mais próximo do que parece."
  },
  {
   "in": 15.98,
   "out": 17.34,
   "texto": "Em três anos de profissão,"
  },
  {
   "in": 17.38,
   "out": 20.4,
   "texto": "eu já trabalhei com mais de 450 marcas."
  },
  {
   "in": 20.44,
   "out": 22.62,
   "texto": "Hoje, além dos meus contratos em dólar,"
  },
  {
   "in": 22.66,
   "out": 24.56,
   "texto": "nos últimos seis meses,"
  },
  {
   "in": 24.6,
   "out": 27.79,
   "texto": "a nossa operação já faturou\nmais de 150 mil dólares."
  },
  {
   "in": 28.49,
   "out": 30.25,
   "texto": "Estou há 15 dias sendo mentorada por eles."
  },
  {
   "in": 30.29,
   "out": 31.97,
   "texto": "Eu já fechei duas parcerias,"
  },
  {
   "in": 32.01,
   "out": 33.19,
   "texto": "sendo uma internacional,"
  },
  {
   "in": 33.23,
   "out": 35.41,
   "texto": "ganhando 50 dólares por semana,"
  },
  {
   "in": 35.45,
   "out": 38.67,
   "texto": "e uma publi que eu fechei\nprospectando a empresa,"
  },
  {
   "in": 38.71,
   "out": 40.79,
   "texto": "ganhando 450 reais."
  },
  {
   "in": 40.83,
   "out": 43.57,
   "texto": "A Sara recebeu uma proposta de parceria\ncom a Magazine Luiza"
  },
  {
   "in": 43.61,
   "out": 47.65,
   "texto": "e procurou direção para analisar\na oportunidade de forma certa."
  },
  {
   "in": 47.69,
   "out": 49.23,
   "texto": "A Bianca ainda estava na primeira aula"
  },
  {
   "in": 49.27,
   "out": 52.45,
   "texto": "e já sentia que finalmente\ntinha encontrado um rumo."
  },
  {
   "in": 52.49,
   "out": 55.01,
   "texto": "E eu posso dizer que eu comecei\nexatamente onde vocês estão, tá?"
  },
  {
   "in": 55.05,
   "out": 55.95,
   "texto": "Num webinar da Duda."
  },
  {
   "in": 55.99,
   "out": 58.57,
   "texto": "Com a orientação certa deles\ne com o seu esforço,"
  },
  {
   "in": 58.61,
   "out": 59.83,
   "texto": "gente, as coisas acontecem."
  },
  {
   "in": 59.87,
   "out": 62.61,
   "texto": "E quando a visão certa encontra execução,"
  },
  {
   "in": 62.65,
   "out": 65.85,
   "texto": "os resultados começam a deixar\nde parecer distantes."
  },
  {
   "in": 65.89,
   "out": 68.47,
   "texto": "Talvez você ainda ache\nque precisa estar pronta,"
  },
  {
   "in": 68.51,
   "out": 69.73,
   "texto": "que precisa saber tudo,"
  },
  {
   "in": 69.77,
   "out": 71.81,
   "texto": "que precisa esperar o momento ideal."
  },
  {
   "in": 71.85,
   "out": 74.85,
   "texto": "Mas a verdade é que\nnenhuma delas começou assim."
  },
  {
   "in": 74.89,
   "out": 77.51,
   "texto": "Elas só decidiram dar o próximo passo."
  },
  {
   "in": 77.55,
   "out": 78.95,
   "texto": "E é isso que muda tudo."
  },
  {
   "in": 78.99,
   "out": 81.83,
   "texto": "Elas começaram exatamente aonde você tá."
  },
  {
   "in": 81.87,
   "out": 84.15,
   "texto": "E decidiram viver o alto nível."
  },
  {
   "in": 84.58,
   "out": 86.1,
   "texto": "Bem-vinda ao Alto Nível."
  }
 ]
